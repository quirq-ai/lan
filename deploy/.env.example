# Copy to .env and fill in.
HS_DOMAIN=hs.example.com          # Headscale (control plane + DERP); DNS A record → this VPS
LAN_DOMAIN=lan.example.com        # lan-server API; DNS A record → this VPS
PUBLIC_IPV4=203.0.113.10          # this VPS's public IP (advertised for the DERP relay)

# Created after first boot: docker compose exec headscale headscale apikeys create --expiration 999d
HEADSCALE_API_KEY=

# Clerk: Dashboard → Configure → OAuth applications → add app (public client, PKCE)
#   redirect URI: http://127.0.0.1:53682/callback   scopes: profile email
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_OAUTH_CLIENT_ID=
